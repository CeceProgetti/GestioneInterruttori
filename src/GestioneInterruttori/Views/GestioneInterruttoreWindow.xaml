<Window x:Class="Views.GestioneInterruttoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestioneInterruttori.Views"
        mc:Ignorable="d"
        Title="Gestione anagrafica interruttori"
        Height="800" Width="1300"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        FontFamily="Segoe UI"
        Background="#EEF0F4">

    <Window.Resources>

        <SolidColorBrush x:Key="ColoreAccento" Color="#D8303F"/>
        <SolidColorBrush x:Key="ColoreAccentoScuro" Color="#B32330"/>
        <SolidColorBrush x:Key="ColoreAccentoTenue" Color="#FBE7E9"/>
        <SolidColorBrush x:Key="ColorePericolo" Color="#7A1F26"/>
        <SolidColorBrush x:Key="ColorePericoloScuro" Color="#5C171C"/>
        <SolidColorBrush x:Key="ColoreTestoPrimario" Color="#1F2430"/>
        <SolidColorBrush x:Key="ColoreTestoSecondario" Color="#6B7280"/>
        <SolidColorBrush x:Key="ColoreBordo" Color="#E2E4EA"/>
        <SolidColorBrush x:Key="ColoreSfondoCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ColoreSfondoPannello" Color="#F7F8FA"/>

        <BooleanToVisibilityConverter x:Key="ConvertiBoolInVisibilita"/>
        <local:NumeroNullableConverter x:Key="ConvertiNumeroNullable"/>

        <!-- ===== Contenitori ===== -->

        <Style x:Key="CardPrincipale" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ColoreSfondoCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColoreBordo}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <!-- Card di una sezione del dettaglio (Anagrafica / Configurazione interruttore / Taglie / ecc.)
             Niente Effect/ombra qui: un DropShadowEffect forza WPF a rasterizzare l'intera card in
             bitmap, e sfoca tutto il testo contenuto (titoli, intestazioni griglia, pulsanti). -->
        <Style x:Key="CardSezione" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColoreBordo}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="TestataSezione" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Barretta di accento colorata davanti al titolo di ogni sezione -->
        <Style x:Key="BarraAccentoTitolo" TargetType="Border">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="{StaticResource ColoreAccento}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="TitoloSezione" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ColoreTestoPrimario}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Etichetta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ColoreTestoSecondario}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- ===== Controlli ===== -->

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColoreBordo}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColoreBordo}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PulsanteBase" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="PulsantePrimario" TargetType="Button" BasedOn="{StaticResource PulsanteBase}">
            <Setter Property="Background" Value="{StaticResource ColoreAccento}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ColoreAccentoScuro}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E8B9BE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PulsanteSecondario" TargetType="Button" BasedOn="{StaticResource PulsanteBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ColoreTestoSecondario}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource ColoreBordo}" BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F1F4"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#C7CAD1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PulsantePericolo" TargetType="Button" BasedOn="{StaticResource PulsanteBase}">
            <Setter Property="Background" Value="{StaticResource ColorePericolo}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ColorePericoloScuro}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F2C9CC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PulsantePiccolo" TargetType="Button" BasedOn="{StaticResource PulsantePrimario}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Griglia" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ColoreBordo}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColoreBordo}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F7"/>
            <Setter Property="Foreground" Value="{StaticResource ColoreTestoSecondario}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColoreBordo}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ColoreAccentoTenue}"/>
                    <Setter Property="Foreground" Value="{StaticResource ColoreTestoPrimario}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titolo + pulsanti azione -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Width="5" CornerRadius="3" Background="{StaticResource ColoreAccento}" Margin="0,2,14,2" VerticalAlignment="Stretch"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Gestione anagrafica interruttori" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ColoreTestoPrimario}"/>
                    <TextBlock Text="Inserimento, modifica ed eliminazione degli interruttori a catalogo" Foreground="{StaticResource ColoreTestoSecondario}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Elimina" Style="{StaticResource PulsantePericolo}" Width="110" Margin="0,0,10,0" Command="{Binding EliminaCommand}"/>
                <Button Content="Salva" Style="{StaticResource PulsantePrimario}" Width="130" Command="{Binding SalvaCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Corpo: elenco (sinistra) + dettaglio a due colonne (destra) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Colonna sinistra: elenco interruttori ===== -->
            <Border Grid.Column="0" Style="{StaticResource CardPrincipale}" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Style="{StaticResource TestataSezione}">
                        <Border Style="{StaticResource BarraAccentoTitolo}"/>
                        <TextBlock Text="Catalogo interruttori" Style="{StaticResource TitoloSezione}"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom" Content="+ Nuovo interruttore" Style="{StaticResource PulsantePrimario}" Margin="0,10,0,0"
                            Command="{Binding NuovoCommand}"/>

                    <DataGrid Style="{StaticResource Griglia}"
                              ItemsSource="{Binding Interruttori}"
                              SelectedItem="{Binding InterruttoreSelezionato}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ===== Colonna destra: dettaglio a due colonne ===== -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Colonna sinistra del dettaglio: Anagrafica + Configurazione interruttore ===== -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Anagrafica base -->
                    <Border Grid.Row="0" Style="{StaticResource CardSezione}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource TestataSezione}">
                                <Border Style="{StaticResource BarraAccentoTitolo}"/>
                                <TextBlock Text="Anagrafica base" Style="{StaticResource TitoloSezione}"/>
                            </StackPanel>

                            <TextBlock Text="NOME" Style="{StaticResource Etichetta}"/>
                            <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="MARCA" Style="{StaticResource Etichetta}"/>
                            <ComboBox ItemsSource="{Binding Marche}" SelectedItem="{Binding MarcaSelezionata}" DisplayMemberPath="Nome"/>

                            <TextBlock Text="SERIE" Style="{StaticResource Etichetta}"/>
                            <ComboBox ItemsSource="{Binding Serie}" SelectedItem="{Binding SerieSelezionata}" DisplayMemberPath="Nome"/>

                            <TextBlock Text="NUMERO POLI" Style="{StaticResource Etichetta}"/>
                            <ComboBox ItemsSource="{Binding NumeriPoli}" SelectedItem="{Binding NumeroPoli}"/>

                            <TextBlock Text="TIPO" Style="{StaticResource Etichetta}"/>
                            <ComboBox ItemsSource="{Binding Tipi}" SelectedItem="{Binding TipoSelezionato}" DisplayMemberPath="Tipo"/>

                            <TextBlock Text="RADICE DWG" Style="{StaticResource Etichetta}"/>
                            <TextBox Text="{Binding RadiceDwg, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Configurazione interruttore: riempie tutto lo spazio verticale rimanente -->
                    <Border Grid.Row="1" Style="{StaticResource CardSezione}" Margin="0,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Style="{StaticResource BarraAccentoTitolo}"/>
                                    <TextBlock Text="Configurazione interruttore" Style="{StaticResource TitoloSezione}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Apri configurazione" Style="{StaticResource PulsantePiccolo}"
                                        Command="{Binding ApriConfigurazioneInterruttoreCommand}"/>
                            </Grid>

                            <DataGrid Grid.Row="1" Style="{StaticResource Griglia}"
                                      ItemsSource="{Binding ConfigurazioniAssegnate}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="*"/>
                                    <DataGridTextColumn Header="Configurazione" Binding="{Binding Nome}" Width="*"/>
                                    <DataGridTextColumn Header="Delta H" Binding="{Binding DeltaH}" Width="0.6*"/>
                                    <DataGridTextColumn Header="Delta L" Binding="{Binding DeltaL}" Width="0.6*"/>
                                    <DataGridTextColumn Header="Delta P" Binding="{Binding DeltaP}" Width="0.6*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                </Grid>

                <!-- ===== Colonna destra del dettaglio: Taglie + Linee prodotto + Configurazione cella ===== -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Taglie e potenza dissipata -->
                    <Border Grid.Row="0" Style="{StaticResource CardSezione}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource TestataSezione}">
                                <Border Style="{StaticResource BarraAccentoTitolo}"/>
                                <TextBlock Text="Taglie e potenza dissipata" Style="{StaticResource TitoloSezione}"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TAGLIA" Style="{StaticResource Etichetta}"/>
                                    <TextBox Text="{Binding NuovaTaglia, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="POTENZA DISSIPATA" Style="{StaticResource Etichetta}"/>
                                    <TextBox Text="{Binding NuovaPotenzaDissipata, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ConvertiNumeroNullable}}" Margin="0"/>
                                </StackPanel>
                                <Button Grid.Column="4" Content="+ Aggiungi" Style="{StaticResource PulsantePiccolo}"
                                        VerticalAlignment="Bottom" Command="{Binding AggiungiTagliaCommand}"/>
                            </Grid>

                            <DataGrid Style="{StaticResource Griglia}" Height="140"
                                      ItemsSource="{Binding TaglieAssegnate}"
                                      SelectedItem="{Binding TagliaSelezionata}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Taglia" Binding="{Binding Taglia}" Width="*"/>
                                    <DataGridTextColumn Header="Potenza dissipata" Binding="{Binding PotenzaDissipata}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Content="Rimuovi selezionata" Style="{StaticResource PulsanteSecondario}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Command="{Binding RimuoviTagliaCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Linee prodotto -->
                    <Border Grid.Row="1" Style="{StaticResource CardSezione}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource TestataSezione}">
                                <Border Style="{StaticResource BarraAccentoTitolo}"/>
                                <TextBlock Text="Linee prodotto" Style="{StaticResource TitoloSezione}"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="LINEA PRODOTTO" Style="{StaticResource Etichetta}"/>
                                    <ComboBox ItemsSource="{Binding LineeProdottoCatalogo}"
                                              SelectedItem="{Binding LineaProdottoDaAggiungere}"
                                              DisplayMemberPath="Nome" Margin="0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="+ Aggiungi" Style="{StaticResource PulsantePiccolo}"
                                        VerticalAlignment="Bottom" Command="{Binding AggiungiLineaProdottoCommand}"/>
                            </Grid>

                            <DataGrid Style="{StaticResource Griglia}" Height="140"
                                      ItemsSource="{Binding LineeProdottoAssegnate}"
                                      SelectedItem="{Binding LineaProdottoAssegnataSelezionata}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Linea prodotto" Binding="{Binding Nome}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Content="Rimuovi selezionata" Style="{StaticResource PulsanteSecondario}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Command="{Binding RimuoviLineaProdottoCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Configurazione cella: riempie lo spazio verticale rimanente -->
                    <Border Grid.Row="2" Style="{StaticResource CardSezione}" Margin="0,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Style="{StaticResource BarraAccentoTitolo}"/>
                                    <TextBlock Text="Configurazione cella" Style="{StaticResource TitoloSezione}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Apri celle" Style="{StaticResource PulsantePiccolo}"
                                        Command="{Binding ApriConfigurazioneCellaCommand}"
                                        ToolTip="Aggiungi almeno una taglia e una linea prodotto per abilitare questa sezione"/>
                            </Grid>

                            <DataGrid Grid.Row="1" Style="{StaticResource Griglia}"
                                      ItemsSource="{Binding CelleAssegnate}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Linea" Binding="{Binding LineaProdotto}" Width="*"/>
                                    <DataGridTextColumn Header="Taglia" Binding="{Binding Taglia}" Width="*"/>
                                    <DataGridTextColumn Header="Alt. cella" Binding="{Binding AltezzaCella}" Width="0.7*"/>
                                    <DataGridTextColumn Header="Larg. cella" Binding="{Binding LarghezzaCella}" Width="0.7*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                </Grid>

            </Grid>

        </Grid>
    </Grid>
</Window>

<Window x:Class="Views.SelezionaInterruttoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestioneInterruttori.Views"
        mc:Ignorable="d"
        Title="Selezione interruttore"
        Height="640" Width="960"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="#F3F4F7">

    <Window.Resources>

        <SolidColorBrush x:Key="ColoreAccento" Color="#2F6FED"/>
        <SolidColorBrush x:Key="ColoreAccentoScuro" Color="#1E4FC4"/>
        <SolidColorBrush x:Key="ColoreTestoPrimario" Color="#1F2430"/>
        <SolidColorBrush x:Key="ColoreTestoSecondario" Color="#6B7280"/>
        <SolidColorBrush x:Key="ColoreBordo" Color="#E2E4EA"/>
        <SolidColorBrush x:Key="ColoreSfondoCard" Color="#FFFFFF"/>

        <!-- Card contenitore con angoli arrotondati -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ColoreSfondoCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColoreBordo}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="Etichetta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ColoreTestoSecondario}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="TitoloSezione" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ColoreTestoPrimario}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColoreBordo}"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="PulsantePrimario" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ColoreAccento}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ColoreAccentoScuro}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#B9C6E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PulsanteSecondario" TargetType="Button" BasedOn="{StaticResource PulsantePrimario}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ColoreTestoSecondario}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource ColoreBordo}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F1F4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Griglia" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ColoreBordo}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F7"/>
            <Setter Property="Foreground" Value="{StaticResource ColoreTestoSecondario}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColoreBordo}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E7EEFD"/>
                    <Setter Property="Foreground" Value="{StaticResource ColoreTestoPrimario}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titolo -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Selezione interruttore" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ColoreTestoPrimario}"/>
            <TextBlock Text="Filtra il catalogo e scegli l'interruttore da inserire nel progetto" Foreground="{StaticResource ColoreTestoSecondario}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Filtri -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="MARCA" Style="{StaticResource Etichetta}"/>
                    <ComboBox ItemsSource="{Binding Marche}"
                              SelectedItem="{Binding MarcaSelezionata}"
                              DisplayMemberPath="Nome"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="SERIE" Style="{StaticResource Etichetta}"/>
                    <ComboBox ItemsSource="{Binding Serie}"
                              SelectedItem="{Binding SerieSelezionata}"
                              DisplayMemberPath="Nome"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="NUMERO POLI" Style="{StaticResource Etichetta}"/>
                    <ComboBox ItemsSource="{Binding NumeriPoli}"
                              SelectedItem="{Binding NumeroPoliSelezionato}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Elenco interruttori -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Interruttori disponibili" Style="{StaticResource TitoloSezione}"/>
                <DataGrid Style="{StaticResource Griglia}"
                          ItemsSource="{Binding Interruttori}"
                          SelectedItem="{Binding InterruttoreSelezionato}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="3*"/>
                        <DataGridTextColumn Header="N. poli" Binding="{Binding NumeroPoli}" Width="*"/>
                        <DataGridTextColumn Header="Radice DWG" Binding="{Binding RadiceDwg}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Configurazioni dell'interruttore selezionato -->
        <Border Grid.Row="4" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Configurazioni disponibili" Style="{StaticResource TitoloSezione}"/>
                <DataGrid Style="{StaticResource Griglia}"
                          ItemsSource="{Binding Configurazioni}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Configurazione" Binding="{Binding Nome}" Width="2*"/>
                        <DataGridTextColumn Header="Delta H" Binding="{Binding DeltaH}" Width="*"/>
                        <DataGridTextColumn Header="Delta L" Binding="{Binding DeltaL}" Width="*"/>
                        <DataGridTextColumn Header="Delta P" Binding="{Binding DeltaP}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Pulsanti -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annulla" Style="{StaticResource PulsanteSecondario}" Width="110" IsCancel="True" Margin="0,0,10,0"/>
            <Button Content="Conferma" Style="{StaticResource PulsantePrimario}" Width="130" Command="{Binding ConfermaCommand}"/>
        </StackPanel>

    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:comuni="clr-namespace:GestioneInterruttori.Comuni">

    <!--
        Stile "filled" per TextBox/ComboBox, standard per tutte le maschere WPF di GestioneInterruttori
        (nate qui in Dati quadro, poi adottato come stile comune). Sfondo grigio chiaro, solo bordo
        inferiore, che diventa rosso e un po' più spesso quando il campo è attivo (focus/hover),
        sfondo che passa a bianco. Altezza fissa 34px identica per TextBox e ComboBox, cosí sono
        sempre allineati quando stanno sulla stessa riga.

        Include le proprie copie dei colori (stessi valori usati ovunque nel progetto) invece di
        referenziare risorse di un altro dizionario: un ResourceDictionary unito (MergedDictionaries)
        non vede le chiavi definite in dizionari fratelli, solo le proprie o quelle di dizionari
        uniti al suo interno - per evitare errori di risoluzione risorsa, i colori sono ripetuti qui.

        Segnaposto (placeholder) delle TextBox: comuni:Segnaposto.Testo="..." sulla TextBox. È disegnato
        dentro il template, nella stessa posizione del testo digitato, ed è visibile solo con il campo vuoto
        e NON attivo: quando il campo ha il focus sparisce, così il cursore non taglia mai la scritta
        (spostarla di qualche pixel non bastava). Non sovrapporre TextBlock
        esterni alla TextBox per fare da segnaposto.

        Uso: aggiungere in Window.Resources/MergedDictionaries
        <ResourceDictionary Source="pack://application:,,,/GestioneInterruttori;component/Stili/CampiInput.xaml"/>
    -->

    <SolidColorBrush x:Key="ColoreAccentoCampi" Color="#D8303F"/>
    <SolidColorBrush x:Key="ColoreTestoPrimarioCampi" Color="#1F2430"/>
    <SolidColorBrush x:Key="ColoreBordoCampi" Color="#E2E4EA"/>

    <Style x:Key="CampoTesto" TargetType="TextBox">
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="#F3F4F7"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColoreBordoCampi}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="Foreground" Value="{StaticResource ColoreTestoPrimarioCampi}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Sfondo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <TextBlock x:Name="TestoSegnaposto" Text="{TemplateBinding comuni:Segnaposto.Testo}"
                                       Foreground="#A0A4AE" Margin="2,0" IsHitTestVisible="False"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsKeyboardFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TestoSegnaposto" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Sfondo" Property="Background" Value="White"/>
                            <Setter TargetName="Sfondo" Property="BorderBrush" Value="{StaticResource ColoreAccentoCampi}"/>
                            <Setter TargetName="Sfondo" Property="BorderThickness" Value="0,0,0,2.5"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Sfondo" Property="Background" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Sfondo" Property="Background" Value="#EAEBEE"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CampoTendina" TargetType="ComboBox">
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Background" Value="#F3F4F7"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColoreBordoCampi}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Resources>
            <!-- La TextBox interna delle ComboBox editabili non deve ereditare lo stile "filled" delle
                 TextBox (altezza 34 + margine inferiore 16 spingerebbero il testo verso l'alto). -->
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </Style.Resources>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColoreAccentoCampi}"/>
                <Setter Property="BorderThickness" Value="0,0,0,2.5"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Applicati a tutte le TextBox / ComboBox delle finestre che uniscono questo dizionario. Gli stili hanno
         anche un nome (CampoTesto / CampoTendina) per poterli estendere, es. in CampiInputCompatti.xaml. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource CampoTesto}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource CampoTendina}"/>

</ResourceDictionary>

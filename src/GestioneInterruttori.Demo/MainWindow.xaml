<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestioneInterruttori.Demo"
        mc:Ignorable="d"
        Title="Demo - GestioneInterruttori" Height="260" Width="420"
        FontFamily="Segoe UI">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="Progetto vetrina per testare le maschere" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <Button Content="Apri maschera completa (Gestione anagrafica)" Height="36" Margin="0,0,0,10"
                Click="ApriGestioneAnagrafica_Click"/>

        <Button Content="Apri solo Configurazioni (interruttore di test, Id=1)" Height="36"
                Click="ApriConfigurazioni_Click"/>
    </StackPanel>
</Window>

<Window x:Class="Views.DialogInformazione"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informazione"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="White">

    <Window.Resources>
        <SolidColorBrush x:Key="ColoreAccento" Color="#D8303F"/>
        <SolidColorBrush x:Key="ColoreAccentoScuro" Color="#B32330"/>
        <SolidColorBrush x:Key="ColoreTestoPrimario" Color="#1F2430"/>
        <SolidColorBrush x:Key="ColoreTestoSecondario" Color="#6B7280"/>
        <SolidColorBrush x:Key="ColoreBordo" Color="#E2E4EA"/>

        <Style x:Key="PulsanteOk" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ColoreAccento}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="22,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Sfondo" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sfondo" Property="Background" Value="{StaticResource ColoreAccentoScuro}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource ColoreBordo}" BorderThickness="1">
        <StackPanel Margin="26,24,26,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border x:Name="CerchioIcona" Width="38" Height="38" CornerRadius="19" Margin="0,0,14,0">
                    <TextBlock x:Name="TestoIcona" FontSize="19" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TestoTitolo" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource ColoreTestoPrimario}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock x:Name="TestoMessaggio" TextWrapping="Wrap" FontSize="13.5"
                       Foreground="{StaticResource ColoreTestoSecondario}" Margin="0,0,0,8"/>
            <TextBlock x:Name="TestoEvidenziato" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource ColoreTestoPrimario}" Margin="0,0,0,22"/>

            <Button Content="OK" Style="{StaticResource PulsanteOk}" HorizontalAlignment="Right"
                    IsDefault="True" IsCancel="True" Click="Ok_Click"/>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="Views.DialogModificheNonSalvate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Modifiche non salvate"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="White">

    <Window.Resources>
        <SolidColorBrush x:Key="ColoreAccento" Color="#D8303F"/>
        <SolidColorBrush x:Key="ColoreAccentoScuro" Color="#B32330"/>
        <SolidColorBrush x:Key="ColoreAccentoTenue" Color="#FBE7E9"/>
        <SolidColorBrush x:Key="ColoreTestoPrimario" Color="#1F2430"/>
        <SolidColorBrush x:Key="ColoreTestoSecondario" Color="#6B7280"/>
        <SolidColorBrush x:Key="ColoreBordo" Color="#E2E4EA"/>

        <Style x:Key="PulsanteScarta" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ColoreTestoSecondario}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource ColoreBordo}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F1F4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PulsanteAnnulla" TargetType="Button" BasedOn="{StaticResource PulsanteScarta}">
            <Setter Property="Foreground" Value="{StaticResource ColoreTestoPrimario}"/>
        </Style>

        <Style x:Key="PulsanteSalva" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ColoreAccento}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Sfondo" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sfondo" Property="Background" Value="{StaticResource ColoreAccentoScuro}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource ColoreBordo}" BorderThickness="1">
        <StackPanel Margin="26,24,26,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource ColoreAccentoTenue}" Margin="0,0,14,0">
                    <TextBlock Text="!" FontSize="19" FontWeight="Bold" Foreground="{StaticResource ColoreAccento}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Modifiche non salvate" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource ColoreTestoPrimario}" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="TestoMessaggio" TextWrapping="Wrap" FontSize="13.5"
                       Foreground="{StaticResource ColoreTestoSecondario}" Margin="0,0,0,22"
                       Text="Ci sono modifiche non salvate. Vuoi salvarle prima di continuare?"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PulsanteAnnullaBtn" Content="Annulla" Style="{StaticResource PulsanteAnnulla}" Margin="0,0,8,0" Click="Annulla_Click"/>
                <Button x:Name="PulsanteScartaBtn" Content="Non salvare" Style="{StaticResource PulsanteScarta}" Margin="0,0,8,0" Click="NonSalvare_Click"/>
                <Button x:Name="PulsanteSalvaBtn" Content="Salva e continua" Style="{StaticResource PulsanteSalva}" Click="Salva_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
